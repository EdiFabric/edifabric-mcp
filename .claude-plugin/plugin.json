{
  "name": "edifabric",
  "displayName": "ediFabric EDI",
  "version": "1.0.0",
  "description": "Validate, parse, build and acknowledge X12 and HIPAA EDI files locally with ediFabric Native.",
  "author": {
    "name": "EdiFabric",
    "email": "support@edifabric.com",
    "url": "https://www.edifabric.com"
  },
  "homepage": "https://www.edifabric.com/docs/edifabric-native/introduction.html",
  "repository": "https://github.com/EdiFabric/edifabric-mcp",
  "license": "MIT",
  "keywords": [
    "edi",
    "x12",
    "hipaa",
    "837",
    "835",
    "850",
    "999",
    "997",
    "mcp"
  ],
  "supportUrl": "https://support.edifabric.com/hc/en-us/requests/new",
  "termsOfServiceUrl": "https://www.edifabric.com/files/eula.pdf",
  "privacyPolicyUrl": "https://www.edifabric.com/files/privacypolicy.pdf",
  "mcpServers": {
    "edifabric": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/src/index.js"
      ],
      "env": {
        "EDIFABRIC_SERIAL": "${user_config.serial}",
        "EDIFABRIC_ALLOWED_DIRS": "${user_config.allowed_folder}"
      }
    }
  },
  "userConfig": {
    "serial": {
      "type": "string",
      "title": "ediFabric serial key",
      "description": "Your serial from https://www.edifabric.com/account.html. Leave it empty to try the server with the demo serial, which has a small daily quota.",
      "sensitive": true,
      "default": ""
    },
    "allowed_folder": {
      "type": "directory",
      "title": "EDI folder",
      "description": "The folder the tools may read and write. Leave it empty to use the folders Claude Code shares with the server.",
      "default": ""
    }
  }
}
